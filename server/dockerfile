FROM node:24.22.1 AS base

WORKDIR /app

# Build from the repository root so the local npm dependency is available.
COPY pdf-service/package.json pdf-service/tsconfig.json /pdf-service/
COPY pdf-service/src/ /pdf-service/src/
COPY server/ ./

RUN --mount=type=cache,target=/root/.npm npm ci

EXPOSE 8000

FROM base AS development
CMD ["npm", "run", "dev"]

FROM base AS production
RUN npm run build
CMD ["npm", "run", "start"]
